{
  "name": "bootstrap5-templates-starter",
  "version": "3.1.1-SNAPSHOT",
  "description": "Bootstrap 5 for Jahia — JS/React template set (page templates + component views)",
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "license": "MIT",
  "author": "Jahia Solutions Group SA",
  "files": [
    "dist/server",
    "settings",
    "META-INF",
    "css"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && yarn pack --out dist/package.tgz",
    "build:maven": "tsc --noEmit && vite build && npm pack && mkdir -p dist && mv bootstrap5-templates-starter-*.tgz dist/package.tgz",
    "clean": "rm -rf dist/",
    "dev": "vite build --watch",
    "deploy": "jahia-deploy",
    "watch": "yarn dev",
    "watch:callback": "yarn pack --out dist/package.tgz && yarn deploy"
  },
  "devDependencies": {
    "@jahia/javascript-modules-library": "^1.3.1",
    "@jahia/vite-plugin": "^1.0.0",
    "@types/react": "^19.0.0",
    "i18next": "^26.3.4",
    "react-i18next": "^16.0.0",
    "rollup-plugin-sbom": "^3.2.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "jahia": {
    "name": "Bootstrap5 Templates Starter",
    "maven": {
      "groupId": "org.jahiacommunity.modules"
    },
    "module-dependencies": "bootstrap5-core, bootstrap5-components",
    "module-type": "templatesSet",
    "server": "dist/server/index.js",
    "static-resources": "/dist/client,/dist/assets,/css",
    "required-version": "8.2.3.0"
  }
}
