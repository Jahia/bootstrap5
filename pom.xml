<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.2.3.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>bootstrap5-modules</artifactId>
    <name>Bootstrap 5 Modules</name>
    <packaging>pom</packaging>
    <version>3.1.1-SNAPSHOT</version>
    <groupId>org.jahiacommunity.modules</groupId>
    <properties>
        <jahia.package.version>1.0</jahia.package.version>
        <frontend-maven-plugin.version>1.15.4</frontend-maven-plugin.version>
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>

        <!--
          SonarQube rules that do not apply to Bootstrap markup. Bootstrap's JavaScript and CSS
          work on <div>, <ul> and <a> elements that carry an ARIA role (modal, carousel, tabs,
          accordion, progress, button group, popover trigger), as its documentation and the ARIA
          Authoring Practices describe; these structures are checked by the axe-core tests.
            S6819: "use a native element instead of the role"
            S6842: "no interactive role on a non-interactive element" (role="tablist" on the <ul>)
            S6845: "tabindex on a non-interactive element" (a tab panel is focusable)
            S7930: "duplicate id" in the privacy settings modal: the two buttons are the two
                   branches of a c:choose, only one is rendered
          The ignores are limited to the component views and to the privacy settings modal.
        -->
        <sonar.issue.ignore.multicriteria>b5a,b5b,b5c,b5d,b5e,b5f,b5g,b5h</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.b5a.ruleKey>typescript:S6819</sonar.issue.ignore.multicriteria.b5a.ruleKey>
        <sonar.issue.ignore.multicriteria.b5a.resourceKey>**/src/components/**/*.tsx</sonar.issue.ignore.multicriteria.b5a.resourceKey>
        <sonar.issue.ignore.multicriteria.b5b.ruleKey>typescript:S6842</sonar.issue.ignore.multicriteria.b5b.ruleKey>
        <sonar.issue.ignore.multicriteria.b5b.resourceKey>**/src/components/Tabs/*.tsx</sonar.issue.ignore.multicriteria.b5b.resourceKey>
        <sonar.issue.ignore.multicriteria.b5c.ruleKey>Web:S6819</sonar.issue.ignore.multicriteria.b5c.ruleKey>
        <sonar.issue.ignore.multicriteria.b5c.resourceKey>**/wemnt_privacySettingsModal/**/*.jsp</sonar.issue.ignore.multicriteria.b5c.resourceKey>
        <sonar.issue.ignore.multicriteria.b5d.ruleKey>Web:S6842</sonar.issue.ignore.multicriteria.b5d.ruleKey>
        <sonar.issue.ignore.multicriteria.b5d.resourceKey>**/wemnt_privacySettingsModal/**/*.jsp</sonar.issue.ignore.multicriteria.b5d.resourceKey>
        <sonar.issue.ignore.multicriteria.b5e.ruleKey>Web:S6845</sonar.issue.ignore.multicriteria.b5e.ruleKey>
        <sonar.issue.ignore.multicriteria.b5e.resourceKey>**/wemnt_privacySettingsModal/**/*.jsp</sonar.issue.ignore.multicriteria.b5e.resourceKey>
        <sonar.issue.ignore.multicriteria.b5f.ruleKey>Web:S7930</sonar.issue.ignore.multicriteria.b5f.ruleKey>
        <sonar.issue.ignore.multicriteria.b5f.resourceKey>**/wemnt_privacySettingsModal/**/*.jsp</sonar.issue.ignore.multicriteria.b5f.resourceKey>
        <!-- S6844 "href requires a valid value": the navbar drop-down toggles are <a href="#" role="button"
             data-bs-toggle="dropdown">, the markup the Bootstrap 5.3 navbar documentation uses (checked by axe-core) -->
        <sonar.issue.ignore.multicriteria.b5g.ruleKey>typescript:S6844</sonar.issue.ignore.multicriteria.b5g.ruleKey>
        <sonar.issue.ignore.multicriteria.b5g.resourceKey>**/src/components/Navbar/default.server.tsx</sonar.issue.ignore.multicriteria.b5g.resourceKey>
        <!-- S6767 "prop defined but never used": the button view hands its props to one render function per
             button type, which the rule does not follow -->
        <sonar.issue.ignore.multicriteria.b5h.ruleKey>typescript:S6767</sonar.issue.ignore.multicriteria.b5h.ruleKey>
        <sonar.issue.ignore.multicriteria.b5h.resourceKey>**/src/components/Button/default.server.tsx</sonar.issue.ignore.multicriteria.b5h.resourceKey>
    </properties>
    <scm>
        <connection>scm:git:git@github.com:Jahia/bootstrap5.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/bootstrap5.git</developerConnection>
        <url>https://github.com/Jahia/bootstrap5.git</url>
        <tag>HEAD</tag>
    </scm>
    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>jahiaRepository</id>
            <name>Jahia's Maven Repository</name>
            <url>https://maven.jahia.org/maven2</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>jahiaRepository</id>
            <name>Jahia's Maven Repository</name>
            <url>https://maven.jahia.org/maven2</url>
        </pluginRepository>
    </pluginRepositories>
    <modules>
        <module>bootstrap5-core</module>
        <module>bootstrap5-components</module>
        <module>bootstrap5-templates-starter</module>
        <module>bootstrap5-package</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.7.11</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>library</projectType>
                    <schemaVersion>1.4</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>false</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                    <outputReactorProjects>true</outputReactorProjects>
                    <outputFormat>json</outputFormat>
                    <outputName>java-bom.cdx</outputName>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
